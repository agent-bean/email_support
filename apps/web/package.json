{
  "name": "email-support-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@12.2.1",
  "engines": {
    "node": "24.22.1",
    "npm": "12.2.1"
  },
  "scripts": {
    "build": "npm run compile:generated && vite build",
    "compile:generated": "tsc --project tsconfig.generated.json",
    "dev": "npm run compile:generated && vite --host 127.0.0.1 --port 5173 --strictPort",
    "format:check": "prettier --check . --ignore-unknown",
    "generate:api": "openapi-ts",
    "lint": "npm run compile:generated && eslint .",
    "test": "npm run compile:generated && vitest run",
    "typecheck": "npm run compile:generated && tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  }
}
